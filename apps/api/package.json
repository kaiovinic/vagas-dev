{
  "name": "@devradar/api",
  "version": "0.1.0",
  "private": true,
  "description": "DevRadar API - agregador de vagas Frontend/Fullstack",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:up": "docker compose -f ../../docker-compose.yml up -d",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "telegram:test": "dotenv -e .env -- tsx scripts/send-telegram-test.ts",
    "telegram:digest": "dotenv -e .env -- tsx scripts/send-weekly-digest.ts",
    "jobs:purge-international": "dotenv -e .env -- tsx scripts/purge-international-jobs.ts",
    "jobs:list-unknown": "dotenv -e .env -- tsx scripts/list-unknown-scope-jobs.ts",
    "jobs:reclassify": "dotenv -e .env -- tsx scripts/reclassify-job-scope.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/schedule": "6.0.1",
    "@prisma/client": "6.16.2",
    "axios": "1.12.2",
    "cheerio": "1.1.2",
    "dotenv": "16.6.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.6",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "3.2.4",
    "dotenv-cli": "10.0.0",
    "prisma": "6.16.2",
    "supertest": "7.1.4",
    "tsc-alias": "1.8.16",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "unplugin-swc": "1.5.7",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  }
}
