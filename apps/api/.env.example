DATABASE_URL="postgresql://devradar:devradar@localhost:5432/devradar?schema=public"
DATABASE_URL_TEST="postgresql://devradar:devradar@localhost:5432/devradar_test?schema=public"
PORT=3333
TZ=America/Bahia

# Alertas no Telegram (opcional: sem isso a captura roda e so nao notifica)
# 1. Fale com o @BotFather no Telegram e crie um bot -> ele devolve o token
# 2. Adicione o bot ao canal/grupo como administrador
# 3. Pegue o id do chat em https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Publicacoes do LinkedIn (opcional) -----------------------------------
# O LinkedIn nao expoe busca de posts por palavra-chave sem autenticacao, e
# raspar logado viola o acordo de uso. O caminho e o indice publico de um
# buscador, via API de SERP. Sem estas duas o coletor e um no-op silencioso.
#
# Em uso com o Serper (https://serper.dev), que indexa o Google. A chamada e
# POST com a consulta no corpo — a unica do projeto que nao e GET.
#
# A conta gratuita limita a 10 resultados por consulta: pedir mais devolve 400
# com "Query pattern not allowed for free accounts". O coletor compensa
# paginando, 3 paginas por captura.
#
# SERP_ENDPOINT so e necessario para apontar para outro fornecedor; vazio, usa
# o Serper.
SERP_ENDPOINT=
SERP_API_KEY=

# --- Gerador de curriculo (opcional) -------------------------------------
# Chave do Google AI Studio (https://aistudio.google.com/apikey). O nivel
# gratuito do Gemini cobre com folga o uso do painel. Sem ela a API sobe
# normalmente e so a rota POST /api/resume/generate falha, com 502.
GEMINI_API_KEY=
# Id do modelo. Vazio usa o padrao do codigo (gemini-3.8-flash). A Google
# aposenta um Flash de tempo em tempo: quando o log acusar 404 de modelo
# indisponivel, o id novo entra aqui e basta reiniciar a API.
GEMINI_MODEL=

# --- Publicacoes do LinkedIn com sessao logada (opcional) ----------------
# Endereco do @devradar/posts-worker, que colhe publicacoes com a conta do
# DevRadar e serve a ultima colheita em GET /posts (RFC 001).
#
# Vazio, o coletor e um no-op silencioso, como o do Serper sem chave: ambiente
# sem a variavel simplesmente nao tem a fonte.
#
# No compose de producao e http://posts-worker:4000; com o worker no host, em
# desenvolvimento, http://127.0.0.1:4000.
LINKEDIN_POSTS_WORKER_URL=
