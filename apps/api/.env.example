DATABASE_URL="postgresql://devradar:devradar@localhost:5432/devradar?schema=public"
DATABASE_URL_TEST="postgresql://devradar:devradar@localhost:5432/devradar_test?schema=public"
PORT=3333
TZ=America/Bahia

# Alertas no Telegram (opcional: sem isso a captura roda e so nao notifica)
# 1. Fale com o @BotFather no Telegram e crie um bot -> ele devolve o token
# 2. Adicione o bot ao canal/grupo como administrador
# 3. Pegue o id do chat em https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Publicacoes do LinkedIn (opcional) -----------------------------------
# O LinkedIn nao expoe busca de posts por palavra-chave sem autenticacao, e
# raspar logado viola o acordo de uso. O caminho e o indice publico de um
# buscador, via API de SERP. Sem estas duas o coletor e um no-op silencioso.
#
# Testado com o contrato do SerpApi (`organic_results`) e do Serper
# (`organic`); os dois cabem na porta GET do projeto.
#   SerpApi : https://serpapi.com/search.json
#   Serper  : https://google.serper.dev/search
SERP_ENDPOINT=
SERP_API_KEY=
